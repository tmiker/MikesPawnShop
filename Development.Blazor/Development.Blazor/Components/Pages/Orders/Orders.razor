@page "/orders"
@rendermode InteractiveServer
@inject IOrdersHttpService _orderHttpService
@using Development.Blazor.Client.DTOs.Orders

<h3>Orders</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="row mt-2">
        <div class="col-10">
            <h5 class="text-danger"><b>Error:</b></h5>
        </div>
        <div class="col-2">
            <a class="btn btn-warning form-control" @onclick="ClearErrorMessage">Clear Errors</a>
        </div>
    </div>
    <div class="row">
        <div class="col-12 text-center">
            <textarea rows="2" class="text-danger form-control"><b>@_errorMessage</b></textarea>
        </div>
    </div>
}

<div class="row">
    <div class="col-12">

        @if (_orders is not null)
        {
            <table class="table table-sm table-bordered text-center">
                <thead class="bg-primary text-light">
                    <tr>
                        <th>Id</th>
                        <th>Order Id</th>
                        <th>Order Date</th>
                        <th>Status</th>
                        <th>Version</th>
                        <th>Item Count</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in _orders)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.OrderId</td>
                            <td>@order.OrderDate.ToShortDateString()</td>
                            <td>@order.Status</td>
                            <td>@order.Version</td>
                            <td>@order.Items.Count</td>
                            <td>
                                <a class="btn btn-primary" @onclick="() => Detail(order.Id)">Detail</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {

        }
    </div>
</div>

<div class="row m2">
    @if (_pagingData is not null)
    {
        <div class="col-2 offset-2">
            <span class="text-primary">Page @_pagingData.CurrentPage of @_pagingData.TotalPageCount</span>
        </div>
        <div class="col-1">
            <a class="btn btn-sm btn-primary form-control" @onclick="PageBackward">Back</a>
        </div>
        <div class="col-1">
            <a class="btn btn-sm btn-primary form-control" @onclick="PageForward">Fwd</a>
        </div>
        <div class="col-2 offset-1">
            <span class="text-primary">Page Size: @_pagingData.PageSize</span>
        </div>
        <div class="col-2">
            <span class="text-primary">Total Items: @_pagingData.TotalItemCount</span>
        </div>
    }
</div>

@code {
    private List<OrderDTO>? _orders;
    private PaginationMetadata? _pagingData;

    private string? _filter = null;
    private string? _sortColumn = "orderdate";
    private string? _sortOrder = "descending";
    private int _pageNumber = 1;
    private int _pageSize = 10;

    private string? _errorMessage;
    private void ClearErrorMessage() => _errorMessage = null;

    private async Task ClearFilters()
    {
        _filter = null;
        _sortColumn = "orderdate"; 
        _sortOrder = "descending";
        _pageSize = 10;
        await RefreshData();
    }

    private async Task PageForward()
    {
        if (_pagingData is null || _pageNumber >= _pagingData.TotalPageCount) return;
        _pageNumber = _pageNumber + 1;
        await RefreshData();
    }

    private async Task PageBackward()
    {
        if (_pageNumber <= 1) return;
        _pageNumber = _pageNumber - 1;
        await RefreshData();
    }

    private void Detail(string id)
    {
        
    }

    private async Task RefreshData()
    {
        var result = await _orderHttpService.GetAllUserOrdersAsync(_filter, _sortColumn, _sortOrder, _pageNumber, _pageSize);
        if (result.IsSuccess)
        {
            _orders = result.OrderDTOs?.ToList();
            _pagingData = result.PagingData;
        }
        else _errorMessage = result.ErrorMessage;
    }

    protected override async Task OnAfterRenderAsync(bool isFirstRender)
    {
        if (isFirstRender)
        {
            Console.WriteLine($"@@@@@@@@@@ **************** Orders.razor OnAfterRender was called. *************** @@@@@@@@@");

            var result = await _orderHttpService.GetAllUserOrdersAsync(_filter, _sortColumn, _sortOrder, _pageNumber, _pageSize);
            if (result.IsSuccess)
            {
                _orders = result.OrderDTOs?.ToList();
                _pagingData = result.PagingData;
            }
            else _errorMessage = result.ErrorMessage;

            this.StateHasChanged();
        }
    }

}
