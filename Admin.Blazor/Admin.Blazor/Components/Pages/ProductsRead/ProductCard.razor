﻿@if (Product != null)
{
    <div class="card bg-dark text-light">
        <div class="card-header ">
            <div class="row">
                <div class="col-12 text-center">
                    <h5 class="text-center"><b>@Product.Name</b></h5>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mt-2">
                <div class="col-6 px-4">
                    <p class="text-warning"><b><i>Id: @Product.Id</i></b></p>
                    <p class="text-warning"><b><i>@Product.Name</i></b></p>
                     <p class="text-warning"><b><i>$ @Product.Price</i></b></p>
                </div>

                <div class="col-6 text-center">
                    @if (Product.Images != null && Product.Images.Any())
                    {
                        <img src="@Product.Images?[0].ThumbnailUrl" height="90" />
                    }
                    else
                    {
                        @* <img class="rounded-top" src="/images/tirade-tiny.jpg" height="90" alt="placeholder" /> *@
                        <img class="rounded" src="/images/image-pending.png" height="90" alt="placeholder" />
                        @* <img src="https://camerastoreproducts.blob.core.windows.net/dev-test/tirade-tiny.jpg" height="90" /> *@
                    }
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-5 offset-1">
                    <a class="btn btn-sm btn-info form-control" @onclick="ProductDetail">Details</a>
                </div>
                <div class="col-5">
                    <a class="btn btn-sm btn-success form-control" @onclick="AddToCart">Add to Cart</a>
                </div>
            </div>
        </div>
        <div class="card-footer text-center">
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12 text-center">
            <h4 class="text-danger text-center"><b>Error retrieving product.</b></h4>
        </div>
    </div>
}

@code {

    [Parameter]
    public ProductDTO? Product { get; set; }

    [Parameter]
    public EventCallback<string> AddToCartCallback { get; set; }

    [Parameter]
    public EventCallback<string> ProductDetailCallback { get; set; }

    private async Task AddToCart()
    {
        await AddToCartCallback.InvokeAsync(Product?.AggregateId.ToString());
    }

    private async Task ProductDetail()
    {
        await ProductDetailCallback.InvokeAsync(Product?.AggregateId.ToString());
    }
}